# OpenAI-compatible router
#   OpenRouter:  https://openrouter.ai/api/v1
#   CleanAPI:    https://<your-host>/v1
#   Groq:        https://api.groq.com/openai/v1
#   Local:       http://localhost:11434/v1
ROUTER_BASE_URL=https://your-router.example/v1
ROUTER_API_KEY=sk-your-api-key-here

# Optional headers (some routers)
# ROUTER_HTTP_REFERER=https://github.com/Raras67/judge-bias
# ROUTER_X_TITLE=judge-bias

# Optional
# HF_TOKEN=hf_xxx

# Optional doc — actual runs use CLI flags:
#   --answer-model  --judge-model
# ANSWER_MODEL_EXAMPLE=gemini-3.7-flash
# JUDGE_MODEL_EXAMPLE=grok-4.6
